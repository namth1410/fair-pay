# =============================================================================
# Fair Pay — environment variables (client/app)
#
# Copy file này thành `.env.local` và điền giá trị thật.
# Các biến `EXPO_PUBLIC_*` sẽ được Expo bundle vào app client → CHỈ chứa
# giá trị PUBLIC (URL, anon key). Tuyệt đối KHÔNG đặt secret/server key ở đây.
# Server-side secrets (R2 access key, service role key) set qua
# `supabase secrets set` cho Edge Function — xem docs README hoặc plan.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Lấy từ Supabase Dashboard → Project Settings → API
# - Project URL: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# - anon / public key: chuỗi JWT bắt đầu bằng `eyJ...` (KHÔNG dùng service_role)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Cloudflare R2 (avatar nhóm) --------------------------------------------
# CHỈ public base URL của bucket — credentials KHÔNG ở đây.
# - Cách A (dev/test): r2.dev subdomain
#     Cloudflare R2 → bucket → Settings → Public access → Allow R2.dev access
#     Format: https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# - Cách B (production): custom domain
#     Cloudflare R2 → bucket → Settings → Custom Domains → Connect Domain
#     Format: https://avatars.your-domain.com
EXPO_PUBLIC_R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# --- Google Sign-In (native) ------------------------------------------------
# Web Client ID — bắt buộc cho native Google Sign-In flow.
# Dùng cho `GoogleSignin.configure({webClientId})` và Supabase verify ID token
# (audience claim phải khớp Web Client ID này).
# Lấy từ Google Cloud Console → APIs & Services → Credentials →
#   OAuth 2.0 Client IDs → Web client (KHÔNG phải Android/iOS client).
# Public (không phải secret) — OK bundle vào app client.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxx-xxxxxxxxxxxxxxx.apps.googleusercontent.com

# =============================================================================
# Server-side secrets (KHÔNG đặt vào file này — chỉ liệt kê để tham khảo)
# Set qua Supabase CLI:
#   supabase secrets set R2_ACCOUNT_ID=...
#   supabase secrets set R2_ACCESS_KEY_ID=...
#   supabase secrets set R2_SECRET_ACCESS_KEY=...
#   supabase secrets set R2_BUCKET_NAME=fairpay-group-avatars
#   supabase secrets set R2_PUBLIC_BASE_URL=https://pub-xxx.r2.dev
# =============================================================================
