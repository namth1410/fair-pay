{
  "expo": {
    "name": "Fair Pay",
    "slug": "fair-pay",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fairpay",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F7F7"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D1FAE5"
      },
      "package": "com.throneware.fairpay",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cho phép Fair Pay dùng camera để chụp avatar nhóm.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Cho phép Fair Pay dùng camera để chụp ảnh hoá đơn và avatar.",
          "enableMicrophonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#F7F7F7",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1A1A1F"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-sharing",
      "@react-native-google-signin/google-signin",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#10B981"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Trip",
              "label": "Fair Pay — Chuyến đi",
              "description": "Số dư & lối tắt tới một chuyến đi",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable"
            }
          ]
        }
      ]
    ],
    "extra": {
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "486fbc86-d177-48b7-a389-f1c101b7d5a8"
      }
    },
    "owner": "namth1410",
    "ios": {
      "bundleIdentifier": "com.throneware.fairpay"
    }
  }
}
